# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.swift]
indent_size = 2
max_line_length = 120

# Trailing whitespace is a hard line break in Markdown, and table rows and long
# links cannot be wrapped, so neither rule applies here.
[*.md]
trim_trailing_whitespace = false
max_line_length = unset

# .env files are plain KEY=value; indentation would change their meaning.
[.env*]
indent_size = unset
max_line_length = unset
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab
