# Base URL of the API this app talks to.
API_URL=https://api.example.com

# Request timeout in seconds.
# env: default=30
TIMEOUT_SECONDS=30

# Enables the in-app debug menu.
FEATURE_DEBUG_MENU=false

# Analytics write key.
# env: secret
ANALYTICS_KEY=replace-me

# Absent in local builds.
# env: optional
SENTRY_DSN=
