# Hostname used to build API_URL in the debug schema. Declared even though no
# Swift property reads it, because an interpolation helper is still part of the
# contract — undeclared keys are reported as warnings.
# env: optional
HOST=

# Base URL of the upstream API.
API_URL=https://api.example.com

# Port the service listens on.
# env: default=8080
PORT=8080

# Log verbosity.
VERBOSE=false

# Hosts permitted to call this service.
ALLOWED_HOSTS=a.example.com,b.example.com

# Credential for the upstream API.
# env: secret
API_KEY=replace-me

# Error reporting endpoint. Absent in local development.
# env: optional
SENTRY_DSN=
